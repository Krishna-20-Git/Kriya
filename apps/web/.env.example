# Leave empty (recommended): the app calls /api on its own origin.
#   - Development: Vite proxies /api to http://localhost:4000 (see vite.config.ts).
#   - Production: vercel.json rewrites /api to the deployed API, so the refresh-token
#     cookie is first-party and works even in browsers that block third-party cookies.
# Set it only if you serve the web app without that proxy, e.g. https://your-api.onrender.com
# (then the API needs COOKIE_SAMESITE=none and COOKIE_SECURE=true).
VITE_API_URL=
