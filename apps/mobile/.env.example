# Base URL of the API — the SAME backend the web app uses. No trailing slash.
#
#   Deployed backend (APK / real phone):  https://your-api.onrender.com
#   Android emulator + local API:         http://10.0.2.2:4000   (10.0.2.2 is the host machine)
#   Real phone on the same Wi-Fi:          http://<your-computer-LAN-IP>:4000
#
# EXPO_PUBLIC_* values are inlined into the JavaScript bundle at build time — never put secrets here.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# Optional: the web app's address. Admins get an "Open Admin on the web" button in Settings.
#   Deployed:  https://your-app.vercel.app
#   Local:     http://<your-computer-LAN-IP>:5173   (start the web app with: npm run dev:web -- --host)
# EXPO_PUBLIC_WEB_URL=
