# ── Required ──────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pms
# HMAC secret for access tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-secret-of-at-least-32-chars

# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated browser origins allowed by CORS (the web app's URL, no trailing slash)
WEB_ORIGIN=http://localhost:5173,http://localhost:4173
# Number of reverse proxies in front of the API. 0 locally; 1 behind a single proxy (Render alone);
# 2 for Vercel → Render (render.yaml), see docs/SECURITY.md "IP-based limits behind proxies".
TRUST_PROXY=0
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────────────────────
# true for managed Postgres that requires TLS (Neon, Render, Supabase)
DATABASE_SSL=false

# ── Sessions ──────────────────────────────────────────────────────────────
# Access token lifetime in seconds (default 15 minutes). Set to 30 to demo expiry handling.
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token lifetime in days (sliding: each refresh extends it)
REFRESH_TOKEN_TTL_DAYS=7
# Refresh-token cookie (web only). COOKIE_SECURE defaults to true when NODE_ENV=production.
# Use COOKIE_SAMESITE=none only if the web app calls the API cross-site without the /api proxy.
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true

# ── Security tuning ───────────────────────────────────────────────────────
# bcrypt cost factor (12 ≈ 250 ms per hash). Tests use 4.
BCRYPT_ROUNDS=12
# Failed logins per IP / 15 min, failed logins per account (email) / 15 min,
# registrations per IP / hour, refreshes per IP / 15 min, all API calls per IP / 15 min
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_PER_ACCOUNT_MAX=10
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_REFRESH_MAX=120
RATE_LIMIT_API_MAX=600

# ── Due-tomorrow push reminders (Android) ────────────────────────────────
# Local hour on each phone's clock from which the reminder is sent (0–23).
REMINDER_HOUR=18
# Run the reminder job inside this process every 15 minutes (good for local dev / always-on servers).
REMINDER_SCHEDULER=false
# Enables POST /api/internal/reminders/run for an external cron (e.g. .github/workflows/reminders.yml).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRON_SECRET=
# Only needed if "Enhanced push security" is turned on for your Expo project.
# EXPO_ACCESS_TOKEN=

# ── Seeding ───────────────────────────────────────────────────────────────
# Password for admin@example.com when seeding a NON-local database (never commit it).
# Locally the seed uses the documented Admin@12345 when this is unset.
# SEED_ADMIN_PASSWORD=
